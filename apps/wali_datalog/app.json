{
  "id": "wali_datalog",
  "title": "BeeM-Flash",
  "description": "BeeM-Flash — live datalogging, whole-vehicle diagnostics, fault-code read/clear, read-only ECU info, map switching and gated calibration flashing for tuned BMW (B58/S58) on the MGU head unit. Independent open-source app, read-only by default.",
  "version": "2.9.0",
  "license": "MIT",
  "vendor": "TunedByWali",
  "loggingId": "BMFL",
  "iconGlyph": "gauge",
  "id8": {
    "id": "wali_datalog8",
    "loggingId": "BMF8",
    "description": "BeeM-Flash — live datalogging, whole-vehicle diagnostics, fault-code read/clear, read-only ECU info, map switching and gated calibration flashing for tuned BMW (B58/S58) on the MGU head unit. Independent open-source app, read-only by default. iDrive 8 (touch; GPU renderer)."
  },
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs",
      "_optional": "engine rpm / coolant temp from the bus (the UDS and OBD-II sources still provide them)"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs",
      "_optional": "vehicle speed from the bus"
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "statusLongitudinalAccelerationMassCenter": "rs",
      "statusLateralAccelerationMassCenter": "rs",
      "_optional": "longitudinal / lateral g used by the dyno power estimate"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "DataPowerTrain2": "s",
      "_optional": "drivetrain status from the bus"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "ExteriorTemperature": "s",
      "_optional": "ambient temperature from the bus"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "title": "BeeM-Flash",
      "kind": "canvas",
      "buttons": [
        [
          "BTN_A",
          "Datalog"
        ],
        [
          "BTN_B",
          "Maps"
        ],
        [
          "BTN_C",
          "Channels"
        ],
        [
          "BTN_D",
          "Connect"
        ]
      ]
    }
  ],
