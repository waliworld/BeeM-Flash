    "boostTarget":  { "did": 16640, "off": 2,  "len": 2, "m": 0.001, "b": -1 },
    "iat":          { "did": 16640, "off": 4,  "len": 2, "m": 0.1,   "b": -40, "signed": true },
    "timing":       { "did": 16640, "off": 6,  "len": 1, "m": 0.5,   "b": -24, "signed": true },
    "knock":        { "did": 16640, "off": 7,  "len": 1, "m": 0.1 },
    "load":         { "did": 16640, "off": 8,  "len": 2, "m": 0.01 },
    "lambda":       { "did": 16640, "off": 10, "len": 2, "m": 0.0001 },
    "lambdaTarget": { "did": 16640, "off": 12, "len": 2, "m": 0.0001 },

    "railPressure": { "did": 16641, "off": 0,  "len": 2, "m": 0.1 },
